{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "staging": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "STS_BUILD_TARGET": "staging"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
