PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stsschool
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail App Password or SMTP)
MAIL_FROM=ssowtheseed@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password

# Admin email log recipients (comma-separated)
ADMIN_LOG_RECIPIENTS=admin@sowtheseed.edu.ng

# FCM (push notifications) — optional
FCM_SERVER_KEY=

# Gemini AI hub (backend/src/utils/ai.ts) — required for POST /ai/ping and any
# future AI feature built on generate(). Use the same key/billing already in
# use for edu-platform: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — only needed if you want the ai.ts hub's built-in per-user rate
# limit. Leave unset and rate limiting stays a no-op (see comments in ai.ts).
REDIS_URL=

NODE_ENV=development
