{
  "name": "sts-school-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:bootstrap": "node --import tsx src/db/bootstrap.ts",
    "db:create-staging-admin": "node --import tsx src/db/createStagingAdmin.ts",
    "db:create-first-admin": "node --import tsx src/db/createFirstAdmin.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:curriculum-audit": "node --import tsx src/db/ingestTopics.ts",
    "db:curriculum-coverage": "node --import tsx src/db/topicsCoverageReport.ts",
    "db:inspect-provenance": "node --import tsx src/db/inspectTopicProvenance.ts",
    "db:remove-topics-by-source": "node --import tsx src/db/removeTopicsBySourceFile.ts",
    "db:reassign-topics-subject": "node --import tsx src/db/reassignTopicsSubject.ts",
    "db:backup-export": "node --import tsx src/db/exportBackup.ts",
    "db:backup-restore": "node --import tsx src/db/restoreBackup.ts",
    "db:check-drift": "tsx src/db/checkDrift.ts",
    "db:backfill-score-class": "tsx src/db/backfillScoreClass.ts",
    "db:check-schools": "tsx src/db/checkSchools.ts",
    "db:ss1:validate-packages": "node --import tsx src/db/ss1/validateSubjectPackages.ts",
    "test:ss1:catering": "node --import tsx --test ../tests/ss1/catering-craft.package.test.mts ../tests/ss1/catering-craft.delivery.test.mts && node --import tsx src/db/ss1/validateSubjectPackages.ts catering-craft",
    "test:ss1:french": "node --import tsx --test ../tests/ss1/french.package.test.mts ../tests/ss1/french.delivery.test.mts ../tests/ss1/french.runtime.test.mts ../tests/ss1/french.audio.test.mts && node --import tsx src/db/ss1/validateSubjectPackages.ts french",
    "test:ss1:mathematics": "node --import tsx --test ../tests/ss1/mathematics.package.test.mts ../tests/ss1/mathematics.delivery.test.mts && node --import tsx src/db/ss1/validateSubjectPackages.ts mathematics",
    "test:ss1:literature": "node --import tsx --test ../tests/ss1/literature.package.test.mts ../tests/ss1/literature.delivery.test.mts && node --import tsx src/db/ss1/validateSubjectPackages.ts literature",
    "test:primary4": "node --import tsx --test ../tests/primary4/source-delivery.test.mts ../tests/primary4/home-economics-package.test.mts ../tests/primary4/home-economics-term3.test.mts ../tests/primary4/basic-science-term3.test.mts ../tests/primary4/basic-technology-terms1-2.test.mts ../tests/primary4/primary4-ingestion.test.mts ../tests/primary4/coverage-report.test.mts",
    "audit:primary4": "node --import tsx src/db/primary4/buildPrimary4CoverageReport.ts"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.11.3",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
