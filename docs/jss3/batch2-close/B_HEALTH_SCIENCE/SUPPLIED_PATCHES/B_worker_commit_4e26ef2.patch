diff --git a/docs/jss3/batch2-close/B_HEALTH_SCIENCE/tests/jss3-b-health-delivery.test.mts b/docs/jss3/batch2-close/B_HEALTH_SCIENCE/tests/jss3-b-health-delivery.test.mts
