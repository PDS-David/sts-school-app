+/**
+ * Read-time delivery correction for JSS 3 secondary topics whose ORIGINAL imported text is unsafe or wrong.
+ * The immutable source/audit row is never rewritten. A matching topic is delivered with the replacement
+ * lesson text instead of its stored source_reference, cached summary or cached generated assessment.
+ *
+ * Matching fails closed: a topic matches when its source_reference hash equals the audited hash, OR when
+ * class, school, term and title identify the audited topic even though the stored text has since changed
+ * (a re-import must never silently re-expose the unsafe teaching).
+ */
+export const JSS3_CORRECTION_MARKER = '[JSS3 DELIVERY CORRECTION]';
+
+type Topic = { school_code?: unknown; class_name?: unknown; term_label?: unknown; title?: unknown;
+  source_reference?: unknown; summary?: unknown; generated_assessment_id?: unknown; [k: string]: unknown };
+interface Entry { id: string; class_name: string; school_code: string; term_label: string; source_body_sha256: string;
+  source_title: string; replacement_lesson_ids: string[]; reason: string }
+export interface Jss3Correction { id: string; text: string; replacementLessonIds: string[]; matchedBy: 'hash' | 'title' }
+
+const entries = corrections as unknown as Entry[];
+const norm = (s: unknown) => String(s ?? '').replace(/\s+/g, ' ').trim().toLowerCase();
+export const sha256 = (s: string) => createHash('sha256').update(s, 'utf8').digest('hex');
+
+export function correctionText(e: Entry): string {
+  const parts = e.replacement_lesson_ids.map(id => {
+    const l = (lessons as any[]).find(x => x.id === id);
+    if (!l) throw new Error(`JSS3 delivery correction ${e.id} names missing lesson ${id}`);
+    return `${l.title}\n\n${l.origin}\n\n${l.body}\n\nReferences:\n${l.sources.map((s: any) => `${s.title}: ${s.url}`).join('\n')}`;
+  });
+  return `${JSS3_CORRECTION_MARKER} ${e.id}\nThe original notes for this topic are withdrawn because they contain unsafe or incorrect teaching. Study the corrected lesson below.\n\n${parts.join('\n\n')}`;
+}
+
+export function jss3CorrectionFor(topic: Topic): Jss3Correction | null {
+  if (topic.school_code !== 'secondary' || topic.class_name !== 'JSS 3') return null;
+  const hash = typeof topic.source_reference === 'string' ? sha256(topic.source_reference) : null;
+  for (const e of entries) {
+    if (e.school_code !== topic.school_code || e.class_name !== topic.class_name) continue;
+    const byHash = hash !== null && hash === e.source_body_sha256;
+    const byTitle = norm(topic.title) === norm(e.source_title) && norm(topic.term_label) === norm(e.term_label);
+    if (byHash || byTitle) return { id: e.id, text: correctionText(e), replacementLessonIds: e.replacement_lesson_ids, matchedBy: byHash ? 'hash' : 'title' };
+  }
+  return null;
+}
+
+/** Student/teacher-facing copy of a topic: corrected text, no stale cache link. Never mutates the stored row. */
+export function safeJss3Topic<T extends Topic>(topic: T): T {
+  const c = jss3CorrectionFor(topic);
+  if (!c) return topic;
+  const cacheCurrent = typeof topic.summary === 'string' && topic.summary === c.text;
+  return { ...topic, source_reference: c.text, summary: c.text,
+    generated_assessment_id: cacheCurrent ? topic.generated_assessment_id : null };
+}
+
+type Q = (text: string, params?: unknown[]) => Promise<{ rows: any[] }>;
+/**
+ * Retire cached output built from the original text: replace the cached summary and, in the SAME statement,
+ * close the previously generated assessment and unlink it (so it can no longer be opened, hinted or submitted
+ * as the topic's assessment). No-op when the cache already holds the corrected text. Returns true if retired.
+ * Existing topic_completions are untouched (unlock-chain resequencing is out of scope).
+ */
+export async function retireStaleJss3Cache(query: Q, stored: Topic & { id: unknown }): Promise<boolean> {
+  const c = jss3CorrectionFor(stored);
+  if (!c) return false;
+  const { rows } = await query(
+    `WITH old AS (SELECT id, generated_assessment_id FROM topics WHERE id=$2 FOR UPDATE),
+          upd AS (UPDATE topics SET summary=$1, generated_assessment_id=NULL
+                  WHERE id=$2 AND summary IS DISTINCT FROM $1 RETURNING id),
+          closed AS (UPDATE assessments SET status='closed'
+                     WHERE id=(SELECT generated_assessment_id FROM old) AND EXISTS (SELECT 1 FROM upd) RETURNING id)
+     SELECT (SELECT count(*) FROM upd) AS retired, (SELECT count(*) FROM closed) AS closed_assessments`,
+    [c.text, stored.id]);
+  return Number(rows[0]?.retired ?? 0) > 0;
+}
