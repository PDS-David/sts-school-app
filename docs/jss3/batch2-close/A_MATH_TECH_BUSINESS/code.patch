diff --git a/backend/src/utils/jss3DeliveryCorrection.ts b/backend/src/utils/jss3DeliveryCorrection.ts
new file mode 100644
index 0000000..f32a80b
--- /dev/null
+++ b/backend/src/utils/jss3DeliveryCorrection.ts
@@ -0,0 +1,44 @@
+import { createHash } from 'node:crypto';
+export interface DeliveryCorrection {
+  id: string; class_name: string; school_code: string; source_body_sha256: string;
+  source_title: string; replacement_lesson_ids: string[];
+}
+export interface DeliveryLesson { id: string; title: string; body: string; origin: string; sources: {title: string; url: string}[] }
+export interface DeliveryTopic { class_name?: string; school_code?: string; source_reference?: string | null; title?: string }
+export const deliveryHash = (s: string) => createHash('sha256').update(s).digest('hex');
+/** Immutable audit rows stay untouched. Routes must use ALL returned teaching for
+ * summaries, fallback, practice and assessment generation. A fingerprint must be
+ * persisted with each generated assessment and checked on direct read/submission.
+ * This pure resolver deliberately does not pretend to implement those DB guards.
+ */
+export function createDeliveryResolver(corrections: readonly DeliveryCorrection[], lessons: readonly DeliveryLesson[]) {
+  const byId = new Map(lessons.map(l => [l.id, l]));
+  if (byId.size !== lessons.length) throw new Error('Duplicate lesson ID');
+  const keys = new Set<string>();
+  for (const c of corrections) {
+    const key = `${c.school_code}|${c.class_name}|${c.source_body_sha256}`;
+    if (!/^[0-9a-f]{64}$/.test(c.source_body_sha256) || keys.has(key)) throw new Error('Invalid or duplicate correction');
+    keys.add(key);
+    if (!c.replacement_lesson_ids.length || new Set(c.replacement_lesson_ids).size !== c.replacement_lesson_ids.length) throw new Error('Empty or duplicate replacement');
+    for (const id of c.replacement_lesson_ids) if (!byId.has(id)) throw new Error(`Missing replacement ${id}`);
+  }
+  return (topic: DeliveryTopic) => {
+    const candidates = corrections.filter(c => c.school_code === topic.school_code && c.class_name === topic.class_name);
+    const hash = deliveryHash(topic.source_reference ?? '');
+    const match = candidates.find(c => c.source_body_sha256 === hash);
+    if (!match) {
+      // A known corrected title with changed/missing source is not safe to fall back.
+      if (candidates.some(c => c.source_title === topic.title)) throw new Error('Corrected source fingerprint mismatch; review required');
+      return null;
+    }
+    const selected = match.replacement_lesson_ids.map(id => byId.get(id)!);
+    const teaching = selected.map(l => `${l.title}\n\n${l.origin}\n\n${l.body}\n\nReferences:\n${l.sources.map(s => `${s.title}: ${s.url}`).join('\n')}`).join('\n\n---\n\n');
+    return Object.freeze({ correctionId: match.id, teaching, sourceHash: hash,
+      fingerprint: deliveryHash(JSON.stringify({id: match.id, source: hash, lessons: selected})),
+      replacementLessonIds: [...match.replacement_lesson_ids] });
+  };
+}
+/** Missing or old cache version must never be accepted as current. */
+export function correctionCacheIsCurrent(expected: string, actual: unknown): boolean {
+  return typeof actual === 'string' && actual === expected;
+}
