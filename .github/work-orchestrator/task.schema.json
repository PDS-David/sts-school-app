{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STS Work Orchestrator Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "gate",
    "status",
    "priority",
    "created_at",
    "updated_at",
    "depends_on",
    "files",
    "acceptance_criteria",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "gate": {
      "enum": [
        "curriculum",
        "application",
        "verification",
        "release",
        "operations"
      ]
    },
    "status": {
      "enum": [
        "backlog",
        "ready",
        "in_progress",
        "blocked",
        "stalled",
        "review",
        "completed",
        "cancelled"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "minItems": 1
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "pull_request": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "result",
          "evidence"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
