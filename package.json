{
  "name": "sts-school-app",
  "version": "1.0.0",
  "private": true,
  "description": "Sow the Seed Schools – Unified Android App + Backend",
  "scripts": {
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "backend:seed": "cd backend && npm run db:seed",
    "mobile:start": "cd mobile && npm start",
    "mobile:android": "cd mobile && npm run android",
    "test:mobile:offline": "node --import tsx --test tests/mobile/offline-replay.test.mts",
    "install:all": "cd backend && npm install && cd ../mobile && npm install",
    "test:ss1:english": "node --import tsx --test tests/ss1/english.package.test.mts",
    "validate:ss1": "node --import tsx backend/src/db/ss1/validateSubjectPackages.ts",
    "ss1:refresh-hashes": "node --import tsx backend/src/db/ss1/refreshIntegrityHashes.ts",
    "validate:ss1:english": "node --import tsx backend/src/db/ss1/validateSubjectPackages.ts english",
    "test:primary4": "cd backend && npm run test:primary4",
    "audit:primary4": "cd backend && npm run audit:primary4",
    "mobile:typecheck": "npm run typecheck --workspace=mobile"
  },
  "workspaces": [
    "backend",
    "mobile"
  ]
}
